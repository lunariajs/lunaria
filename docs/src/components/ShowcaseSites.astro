		title="EmDash CMS"
		href="https://i18n.emdashcms.com/"
		thumbnail="i18n.emdashcms.com.png"
	/>
	<Card
		title="npmx"
		href="https://main.npmx.dev/translation-status"
		thumbnail="npmx.dev.jpg"
	/>
