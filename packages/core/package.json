{
  "name": "@lunariajs/core",
  "version": "0.1.1",
  "description": "Localization management system for open-source projects",
  "keywords": [
    "i18n",
    "l10n",
    "translation",
    "localization",
    "management"
  ],
  "bugs": "https://github.com/lunariajs/lunaria/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunariajs/lunaria.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Yan Thomas",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "consola": "^3.4.2",
    "gettext-parser": "^9.1.1",
    "jiti": "^2.7.0",
    "neotraverse": "^1.0.1",
    "p-all": "^5.0.1",
    "path-to-regexp": "6.3.0",
    "picomatch": "^4.0.7",
    "simple-git": "^3.36.0",
    "tinyglobby": "^0.2.17",
    "ultramatter": "^0.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/gettext-parser": "^9.0.0",
    "@types/node": "^22.20.2",
    "@types/picomatch": "^4.0.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
