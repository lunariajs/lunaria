---
import Earth from './icons/Earth.astro';
import Home from './icons/Home.astro';
import ThemeSelector from './theme/ThemeSelector.astro';

const currentPage = Astro.url.pathname;
const pages = [
	{
		label: 'Overview',
		href: '/',
	},
	{
		label: 'Locales',
		href: '/locales',
	},
];
---

<div class="sidebar-container">
  <nav aria-label="Main">
    <ul>
      {
        pages.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={currentPage === href ? "page" : undefined}
            >
              {href === "/" ? (
                <Home width="24" height="24" />
              ) : (
                <Earth width="24" height="24" />
              )}
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeSelector />
</div>

<style>
  .sidebar-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    height: 100%;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  a {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
    padding-block: 0.5rem;
    padding-inline: 1rem;
    border-radius: 0.5rem;
  }

  a[aria-current="page"],
  a:hover {
    background-color: var(--ln-color-gray-6);
  }
</style>
